STACK_NAME=naqfc-o3-ak
PROJECT=naqfc
#GARBAGE_COLLECTION_FREQUENCY=2

# Forward SQS consumer. Leave unset to default: enabled normally, but disabled
# automatically when BACKFILL_ENABLED=true (so the backfill bootstraps main first).
# After the backfill promotes, set FORWARD_QUEUE_ENABLED=true and redeploy.
# FORWARD_QUEUE_ENABLED=false

STAGE=dev
ACCOUNT_ID=976193266315
ACCOUNT_REGION=us-west-2


#ICECHUNK_BUCKET_NAME=naqfc
ICECHUNK_BUCKET=airquality-data-store-develop
ICECHUNK_PREFIX=naqfc/aqmv7/o3_ak
BACKFILL_BUCKET=airquality-virtualizarr-backfill
BACKFILL_PREFIX=naqfc

# NAQFC specific settings
NAQFC_DOMAIN=AK
NAQFC_PRODUCT=ave_1hr_o3
NAQFC_VARIABLE=ozcon
NAQFC_KEY_PATTERN=AQMv7/AK/*.ave_1hr_o3.*.198.grib2
NAQFC_START=2024-05-14
NAQFC_END=2026-09-08

# Garbage collection runs in an AWS Batch cluster inside a VPC.
# Enabling it requires BOTH of the following, and `cdk synth` will then
# perform a VPC lookup that needs real AWS credentials for ACCOUNT_ID.
# GARBAGE_COLLECTION_FREQUENCY=2
# VPC_ID=vpc-0123456789abcdef0
#
#
## --- Backfill (partitioned fork/merge) pipeline ---
BACKFILL_ENABLED=true
BACKFILL_PARTITION_SIZE=500
BACKFILL_MAX_ITEMS_PER_BATCH=10
BACKFILL_MAX_CONCURRENCY=50

## --- Forward processing ---
SNS_TOPIC=arn:aws:sns:us-east-1:709902155096:NewNWSAirQualityObject
FORWARD_QUEUE_ENABLED=true
MAX_CONCURRENCY=2
